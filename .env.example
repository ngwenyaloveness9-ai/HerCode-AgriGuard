# Data source: "firebase" (ESP32 -> Firebase) or "api" (ESP32 -> Node.js -> Firebase)
VITE_DATA_SOURCE=firebase

# Staleness threshold in seconds. A reading older than this is labelled STALE DATA.
VITE_STALE_DATA_SECONDS=120

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

VITE_API_BASE_URL=
VITE_SOCKET_URL=
