# --- Firebase ---------------------------------------------------------------
# Either point at a service-account JSON file...
GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json
# ...or supply the JSON inline (useful for Cloud Run / Render / Railway).
FIREBASE_CREDENTIALS_JSON=
FIREBASE_PROJECT_ID=

# --- Server -----------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO

# Comma-separated origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173

# --- Telemetry rules --------------------------------------------------------
# A reading older than this is reported as stale. Must match the frontend value.
STALE_DATA_SECONDS=120

# How long a command may sit unconfirmed before it is marked failed.
COMMAND_TIMEOUT_SECONDS=45

# --- Device ingest ----------------------------------------------------------
# Shared secret the ESP32 sends in the X-Device-Key header.
DEVICE_INGEST_KEY=
